<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>gcexp</AssemblyName>
    <RootNamespace>Gcexp</RootNamespace>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <AssemblyName>gcexp</AssemblyName>
    <RootNamespace>Gcexp</RootNamespace>
    <Version>0.10.0</Version>
    <AssemblyVersion>0.10.0.0</AssemblyVersion>
    <FileVersion>0.10.0.0</FileVersion>
    <InformationalVersion>0.10.0</InformationalVersion>
    <Product>GCExp</Product>
    <Company>MRI Software</Company>
    <Copyright>Copyright © Danijel-James Wynyard. All rights reserved.</Copyright>
    <Description>Cross-platform certificate and cryptographic key expiry checker</Description>
    <ApplicationIcon Condition="$([MSBuild]::IsOSPlatform('Windows'))">assets\gcexp.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
